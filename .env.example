# Copy this file to .env.local and fill in the real value. Never commit .env.local.
# Web3Forms access key — get one free at https://web3forms.com (sent to the owner's email)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public address of the live site, no trailing slash. Used for canonical URLs,
# hreflang links, sharing previews, sitemap.xml and robots.txt.
# TODO(owner): set the real domain, e.g. https://needforcars.ge
NEXT_PUBLIC_SITE_URL=
